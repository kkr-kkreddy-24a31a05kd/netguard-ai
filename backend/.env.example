# NetGuard AI Backend Environment Configuration

PROJECT_NAME="NetGuard AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# JWT Authentication
SECRET_KEY="replace_with_a_secure_random_secret_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (PostgreSQL or local SQLite for development)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/netguard_db"
# Fallback dev url: "sqlite:///./netguard.db"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Server Configuration
HOST="0.0.0.0"
PORT=8000
